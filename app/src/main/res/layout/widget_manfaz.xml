<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Manfaz VPN"
        android:scaleType="centerInside"
        android:src="@drawable/logo_manfaz" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANFAZ VPN"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="اتصال سریع به آخرین سرور"
            android:textColor="#EFFFFFFF"
            android:textDirection="rtl"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_action_background"
        android:gravity="center"
        android:text="اتصال"
        android:textColor="#FFFF6A00"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
